    "Treating visual/OCR uncertainty as confirmed fact without review status."
  ],
  "ruleAuthorityChecks": [
    "deadline_has_sourceAuthority",
    "deadline_has_sourceName_or_sourceDocNo",
    "uses_highest_applicable_authority",
    "case_order_controls_over_judge_part_rule",
    "judge_part_rule_controls_over_county_general_rule",
    "later_order_supersedes_earlier_order"
  ]
