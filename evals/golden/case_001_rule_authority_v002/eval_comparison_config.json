{
  "exactMatchFields": [
    "expectedDocumentType",
    "expectedFilingDate",
    "expectedNyscefDocNo",
    "caseIdentity.indexNumber",
    "caseIdentity.county",
    "caseIdentity.judgeName",
    "caseIdentity.partName",
    "expectedRuleSourcesApplied",
    "expectedRuleAuthorityBehavior.mustIncludeSourceAuthorityOnFinalDeadlines"
  ],
  "semanticMatchFields": [
    "expectedConfirmedFacts",
    "expectedTasks.taskDescription",
    "snapshotExpectedOutputs.*.confirmedFacts",
    "snapshotExpectedOutputs.*.openTasks"
  ],
  "guardrailFields": [
    "mustNotCreate",
    "negativeGuardrailTests"
  ],
  "criticalFailureRules": [
    "Creating a final answer/response deadline without verified service date and method.",
    "Creating a deadline for defendant to respond to Certificate of Merit.",
